# Cloudflare Pages headers
# Geldt voor alle pagina's
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# API routes: geen caching in browser
/api/*
  Cache-Control: no-store

# Verborgen statistiekpagina: niet indexeren
/stats
  X-Robots-Tag: noindex, nofollow
/stats.html
  X-Robots-Tag: noindex, nofollow

# Verborgen spelpagina: niet indexeren en nooit uit de cache serveren
/utreg84.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, must-revalidate

# Wisselcoach: niet indexeren en altijd verse versie
/wisselcoach.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, must-revalidate

# Coachbord: niet indexeren en altijd verse versie
/coachbord.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, must-revalidate

# Coach Assistant: niet indexeren en altijd verse versie
/coach-assistant.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, must-revalidate

# Voorkeurspagina spelers: niet indexeren, altijd vers
/voorkeur.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, must-revalidate
